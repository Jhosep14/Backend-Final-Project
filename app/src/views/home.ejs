<%- include("partials/header") %>

<main>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="hero-label">A LITTLE MORE ENGLISH, EVERY DAY</p>
        <h1>Follow your<br><em>curiosity.</em></h1>
        <p class="hero-description">A place to learn, explore, and find your next favorite book.</p>
        <a class="button button-dark" href="/book">Explore the library <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-orbit"></div>
        <img class="hero-cover hero-cover-back" src="/images/covers/voices-a2.jpg" alt="">
        <img class="hero-cover hero-cover-front" src="/images/covers/gateway-a1.jpg" alt="">
        <span class="hero-note">A good place<br>to begin.</span>
      </div>
    </div>
  </section>

  <section class="home-library wrap" aria-labelledby="library-heading">
    <div class="section-heading">
      <div><p class="section-label">YOUR LEARNING SPACE</p><h2 id="library-heading">A little something for every level.</h2></div>
      <a class="text-link" href="/book">See all books <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-books">
      <% if (typeof books !== "undefined") { books.forEach((book) => { %>
        <article class="home-book">
          <div class="home-book-cover"><img src="<%= book.cover %>" alt="Cover of <%= book.title %>" loading="lazy"></div>
          <div class="home-book-details"><span><%= book.level %></span><h3><%= book.title %></h3><p><%= book.subtitle %></p></div>
        </article>
      <% }) } else { %>
        <p>Books will appear here when the library is connected.</p>
      <% } %>
    </div>
  </section>
</main>

<%- include("partials/footer") %>

